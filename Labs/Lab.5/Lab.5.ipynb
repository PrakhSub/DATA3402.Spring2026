    "class Matrix:\n",
    "    def __init__(self, *args):\n",
    "        # Case 1: Initializing with n and m\n",
    "        if len(args) == 2 and isinstance(args[0], int) and isinstance(args[1], int):\n",
    "            n, m = args\n",
    "            self._data = [[0.0 for _ in range(m)] for _ in range(n)]\n",
    "            self._rows = n\n",
    "            self._cols = m\n",
    "        \n",
    "        # Case 2: Initializing with a list of lists\n",
    "        elif len(args) == 1 and isinstance(args[0], list):\n",
    "            data = args[0]\n",
    "            if not data:\n",
    "                self._data, self._rows, self._cols = [], 0, 0\n",
    "                return\n",
    "            first_row_len = len(data[0])\n",
    "            for row in data:\n",
    "                if not isinstance(row, list) or len(row) != first_row_len:\n",
    "                    raise ValueError(\"Matrix improperly specified\")\n",
    "            \n",
    "            self._data = [list(row) for row in data]\n",
    "            self._rows = len(data)\n",
    "            self._cols = first_row_len\n",
    "\n",
    "    def shape(self):\n",
    "        return (self._rows, self._cols)\n",
    "\n",
    "    def scalarmul(self, c):\n",
    "        new_data = [[val * c for val in row] for row in self._data]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def add(self, other):\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions must match for addition\")\n",
    "        \n",
    "        new_data = [[self._data[i][j] + other._data[i][j] for j in range(self._cols)] \n",
    "                    for i in range(self._rows)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def sub(self, other):\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions must match for subtraction\")\n",
    "        \n",
    "        new_data = [[self._data[i][j] - other._data[i][j] for j in range(self._cols)] \n",
    "                    for i in range(self._rows)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def mat_mult(self, other):\n",
    "        if self._cols != other._rows:\n",
    "            raise ValueError(\"Inner dimensions must match for matrix multiplication\")\n",
    "        \n",
    "        new_data = []\n",
    "        for i in range(self._rows):\n",
    "            new_row = []\n",
    "            for j in range(other._cols):\n",
    "                cell_value = sum(self._data[i][k] * other._data[k][j] for k in range(self._cols))\n",
    "                new_row.append(cell_value)\n",
    "            new_data.append(new_row)\n",
    "        \n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def element_mult(self, other):\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions must match for element-wise multiplication\")\n",
    "        \n",
    "        new_data = [[self._data[i][j] * other._data[i][j] for j in range(self._cols)] \n",
    "                    for i in range(self._rows)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def equals(self, other):\n",
    "        if self.shape() != other.shape():\n",
    "            return False\n",
    "        \n",
    "        for i in range(self._rows):\n",
    "            for j in range(self._cols):\n",
    "                if self._data[i][j] != other._data[i][j]:\n",
    "                    return False\n",
    "        return True\n",
    "\n",
    "    def __str__(self):\n",
    "        return \"\\n\".join([str(row) for row in self._data])\n",
    "\n",
    "m1 = Matrix([[1, 2], [3, 4]])\n",
    "m2 = Matrix([[5, 6], [7, 8]])\n",
    "\n",
    "print(\"Matrix M1:\")\n",
    "print(m1)\n",
    "print(\"\\nMatrix M2:\")\n",
    "print(m2)\n",
    "\n",
    "print(\"\\n1. Scalar Multiplication (M1 * 10):\")\n",
    "print(m1.scalarmul(10))\n",
    "\n",
    "print(\"\\n2. Matrix Addition (M1 + M2):\")\n",
    "print(m1.add(m2))\n",
    "\n",
    "print(\"\\n3. Matrix Subtraction (M1 - M2):\")\n",
    "print(m1.sub(m2))\n",
    "\n",
    "print(\"\\n4. Matrix Product (M1 dot M2):\")\n",
    "print(m1.mat_mult(m2))\n",
