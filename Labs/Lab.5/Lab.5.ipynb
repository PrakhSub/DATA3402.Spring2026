    "class Matrix:\n",
    "    def __init__(self, *args):\n",
    "        if len(args) == 2 and isinstance(args[0], int):\n",
    "            n, m = args\n",
    "            self._data = [[0.0 for _ in range(m)] for _ in range(n)]\n",
    "            self._rows, self._cols = n, m\n",
    "        elif len(args) == 1 and isinstance(args[0], list):\n",
    "            data = args[0]\n",
    "            row_len = len(data[0]) if data else 0\n",
    "            self._data = [list(row) for row in data]\n",
    "            self._rows, self._cols = len(data), row_len\n",
    "\n",
    "    def shape(self):\n",
    "        return (self._rows, self._cols)\n",
    "\n",
    "    # Operator Overloading\n",
    "\n",
    "    def __add__(self, other):\n",
    "        \"\"\"Overloads M + N\"\"\"\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions must match for addition\")\n",
    "        new_data = [[self._data[i][j] + other._data[i][j] for j in range(self._cols)] \n",
    "                    for i in range(self._rows)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def __sub__(self, other):\n",
    "        \"\"\"Overloads M - N\"\"\"\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions must match for subtraction\")\n",
    "        new_data = [[self._data[i][j] - other._data[i][j] for j in range(self._cols)] \n",
    "                    for i in range(self._rows)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def __mul__(self, other):\n",
    "        \"\"\"Overloads M * 2 (Scalar) or M * N (Matrix Multi)\"\"\"\n",
    "        if isinstance(other, (int, float)):\n",
    "            new_data = [[val * other for val in row] for row in self._data]\n",
    "            return Matrix(new_data)\n",
    "        elif isinstance(other, Matrix):\n",
    "            if self._cols != other._rows:\n",
    "                raise ValueError(\"Inner dimensions must match\")\n",
    "            new_data = [[sum(self._data[i][k] * other._data[k][j] for k in range(self._cols))\n",
    "                         for j in range(other._cols)] for i in range(self._rows)]\n",
    "            return Matrix(new_data)\n",
    "        return NotImplemented\n",
    "\n",
    "    def __rmul__(self, other):\n",
    "        \"\"\"Overloads 2 * M (Right-hand multiplication)\"\"\"\n",
    "        return self.__mul__(other)\n",
    "\n",
    "    def __eq__(self, other):\n",
    "        \"\"\"Overloads M == N\"\"\"\n",
    "        if not isinstance(other, Matrix) or self.shape() != other.shape():\n",
    "            return False\n",
    "        for i in range(self._rows):\n",
    "            for j in range(self._cols):\n",
    "                if self._data[i][j] != other._data[i][j]:\n",
    "                    return False\n",
    "        return True\n",
    "\n",
    "    def set_values(self, other):\n",
    "        \"\"\"Simulates M1 = M2 logic with size checking\"\"\"\n",
    "        if self.shape() != other.shape():\n",
    "            raise ValueError(\"Dimensions do not match for assignment\")\n",
    "        self._data = [list(row) for row in other._data]\n",
    "\n",
    "    def __str__(self):\n",
    "        return \"\\n\".join([str(row) for row in self._data])\n",
    "\n",
    "M = Matrix([[1, 2], [3, 4]])\n",
    "N = Matrix([[5, 6], [7, 8]])\n",
    "\n",
    "print(\"Matrix M:\")\n",
    "print(M)\n",
    "\n",
    "print(\"\\n1. Testing 2 * M (Scalar):\")\n",
    "print(2 * M)\n",
    "\n",
    "print(\"\\n2. Testing M * 2 (Scalar):\")\n",
    "print(M * 2)\n",
    "\n",
    "print(\"\\n3. Testing M + N:\")\n",
    "print(M + N)\n",
    "\n",
    "print(\"\\n4. Testing M - N:\")\n",
    "print(M - N)\n",
    "\n",
    "print(\"\\n5. Testing M * N (Matrix Product):\")\n",
    "print(M * N)\n",
    "\n",
    "print(\"\\n6. Testing M == N:\")\n",
    "print(M == N)\n",
    "\n",
    "print(\"\\n7. Testing M == M:\")\n",
    "print(M == M)\n",
    "\n",
    "# 1. __rmul__: When you type 2 * M, Python first looks at the number 2 and asks if it knows how to multiply by a Matrix. It doesn't. So it then looks at the Matrix and calls __rmul__ (Reverse Multiplication).\n",
    "\n",
    "# 2. isinstance(other, (int, float)): This checks if the thing we are multiplying by is a number. If it is, we do scalar multiplication; if it's another Matrix, we do matrix multiplication.\n",
    "\n",
    "# 3. NotImplemented: This is a special Python signal. If we try to multiply a Matrix by something we haven't defined (like a string), returning this tells Python \"I don't know how to do this,\" which triggers a standard error."
