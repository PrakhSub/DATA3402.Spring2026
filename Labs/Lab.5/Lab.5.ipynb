    "class Matrix:\n",
    "    def __init__(self, *args):\n",
    "        # Case 1: Initializing with n and m\n",
    "        if len(args) == 2 and isinstance(args[0], int) and isinstance(args[1], int):\n",
    "            n, m = args\n",
    "            self._data = [[0 for _ in range(m)] for _ in range(n)]\n",
    "            self._rows = n\n",
    "            self._cols = m\n",
    "        \n",
    "        # Case 2: Initializing with a list of lists\n",
    "        elif len(args) == 1 and isinstance(args[0], list):\n",
    "            data = args[0]\n",
    "            if not data:\n",
    "                self._data = []\n",
    "                self._rows = 0\n",
    "                self._cols = 0\n",
    "                return\n",
    "            first_row_len = len(data[0])\n",
    "            for row in data:\n",
    "                if not isinstance(row, list) or len(row) != first_row_len:\n",
    "                    raise ValueError(\"Matrix improperly specified: rows have different lengths\")\n",
    "            \n",
    "            self._data = [list(row) for row in data]\n",
    "            self._rows = len(data)\n",
    "            self._cols = first_row_len\n",
    "\n",
    "    def shape(self):\n",
    "        return (self._rows, self._cols)\n",
    "\n",
    "    def to_list(self):\n",
    "        # Returns a deep copy of the data using list comprehension\n",
    "        return [list(row) for row in self._data]\n",
    "\n",
    "    def transpose(self):\n",
    "        # Create new data where rows and columns are swapped\n",
    "        new_data = [[self._data[j][i] for j in range(self._rows)] for i in range(self._cols)]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def row(self, n):\n",
    "        # Returns the nth row as a 1 x m Matrix\n",
    "        return Matrix([list(self._data[n])])\n",
    "\n",
    "    def column(self, n):\n",
    "        # Returns the nth column as an n x 1 Matrix\n",
    "        new_col = [[self._data[i][n]] for i in range(self._rows)]\n",
    "        return Matrix(new_col)\n",
    "\n",
    "    def block(self, n0, n1, m0, m1):\n",
    "        # Slices rows from n0 to n1 and columns from m0 to m1\n",
    "        new_data = [row[m0:m1] for row in self._data[n0:n1]]\n",
    "        return Matrix(new_data)\n",
    "\n",
    "    def __getitem__(self, index):\n",
    "        # Support for slicing and indexing\n",
    "        if isinstance(index, tuple):\n",
    "            row_idx, col_idx = index\n",
    "            if isinstance(row_idx, slice) or isinstance(col_idx, slice):\n",
    "                rows = self._data[row_idx]\n",
    "                if not isinstance(rows[0], list):\n",
    "                    rows = [rows]\n",
    "                \n",
    "                sliced_data = [r[col_idx] for r in rows]\n",
    "                # If the result is a single value (not a list), return it directly\n",
    "                if not isinstance(sliced_data[0], list):\n",
    "                    return sliced_data[0]\n",
    "                return Matrix(sliced_data)\n",
    "            return self._data[row_idx][col_idx]\n",
    "        return self._data[index]\n",
    "\n",
    "    def __str__(self):\n",
    "        return \"\\n\".join([str(row) for row in self._data])\n",
    "\n",
